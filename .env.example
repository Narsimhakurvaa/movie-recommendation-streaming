# ---------------------------------------------------------------------------
# CineVault - example environment configuration
#
# Copy to `.env` and adjust:   cp .env.example .env
# NEVER commit a real .env file. It is already in .gitignore.
#
# Only JWT_SECRET is strictly required. Every other variable has a working
# default suitable for local development.
# ---------------------------------------------------------------------------


# ===========================================================================
# REQUIRED
# ===========================================================================

# Signing key for JWT access tokens (HS256).
# Must decode to at least 32 bytes or the application refuses to start - there
# is deliberately no default, so a deployment cannot fall back to a known key.
#
#   openssl rand -base64 48
#
JWT_SECRET=REPLACE_WITH_BASE64_SECRET_AT_LEAST_32_BYTES


# ===========================================================================
# DATABASE  (PostgreSQL 16+)
# ===========================================================================

DATABASE_URL=jdbc:postgresql://localhost:5432/cinevault
DATABASE_USERNAME=cinevault
DATABASE_PASSWORD=change-me-locally

# Used by docker compose to create the database and publish its port.
DATABASE_NAME=cinevault
DATABASE_PORT=5432

# HikariCP pool size. Keep it comfortably below the server's max_connections
# divided by the number of application instances.
DB_POOL_SIZE=10


# ===========================================================================
# APPLICATION
# ===========================================================================

# dev = seed data + Swagger + debug logging
# prod = no seed data, no Swagger, warn-level logging, real mail sender required
SPRING_PROFILES_ACTIVE=dev

# Port the backend binds. Hosting platforms that inject PORT (Render, Railway,
# Heroku, Cloud Run) take precedence over SERVER_PORT automatically.
SERVER_PORT=8080

# Seconds to let in-flight requests finish during a rolling deploy.
SHUTDOWN_TIMEOUT=25s

# Log level for application classes. Never DEBUG in production.
LOG_LEVEL=INFO

# dev profile only: logs Hibernate query counts per session, which makes an
# accidental N+1 visible. Noisy, so it is off by default.
HIBERNATE_STATISTICS=false


# ===========================================================================
# CORS AND FRONTEND
# ===========================================================================

# Comma-separated list of browser origins allowed to call the API.
# NEVER a wildcard: credentials are enabled, and `*` with credentials is both
# forbidden by the CORS spec and a genuine security hole.
#
# Local dev:  http://localhost:5173,http://localhost:4173
# Production: https://your-frontend.vercel.app
#
# Origins only - no trailing slash, no path.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Base URL used to build links in password-reset and verification messages.
FRONTEND_URL=http://localhost:5173

# Port nginx publishes the frontend on under docker compose.
FRONTEND_PORT=3000


# ===========================================================================
# JWT TUNING  (defaults are sensible; override only with reason)
# ===========================================================================

JWT_ISSUER=cinevault
# Short-lived: a stolen access token expires quickly.
JWT_ACCESS_TOKEN_TTL=PT15M
# Long-lived but rotated on every use, with reuse detection.
JWT_REFRESH_TOKEN_TTL=P30D


# ===========================================================================
# MOVIE METADATA PROVIDER
# ===========================================================================

# `local` serves the seeded catalogue and needs no credentials or internet.
# `tmdb` fetches live metadata and requires TMDB_API_KEY; if the key is missing
# the application logs a warning and falls back to `local` rather than failing.
MOVIE_PROVIDER=local

TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_TIMEOUT=PT5S


# ===========================================================================
# REDIS  (OPTIONAL - the application runs fully without it)
# ===========================================================================

# `memory` = in-process cache. Correct for a single instance; no Redis needed.
# `redis`  = shared cache. Use when running more than one instance, or when the
#            cache should survive a restart. Requires REDIS_URL.
CACHE_TYPE=memory

REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Report Redis in /actuator/health. Leave false while CACHE_TYPE=memory,
# otherwise a missing cache would mark a healthy application as DOWN.
CACHE_TYPE_REDIS_HEALTH=false


# ===========================================================================
# RATE LIMITING
# ===========================================================================

RATE_LIMIT_ENABLED=true
# Requests per minute per client against /api/auth/* endpoints.
RATE_LIMIT_CAPACITY=20


# ===========================================================================
# API DOCUMENTATION
# ===========================================================================

# Swagger UI at /swagger-ui.html. Defaults to false under the prod profile.
OPENAPI_ENABLED=true


# ===========================================================================
# RECOMMENDATION ENGINE
# ===========================================================================

# Films scored per request. Personalisation reorders the popularity head rather
# than rescuing titles from the far tail, so this bound costs no relevance.
RECOMMENDATION_POOL_SIZE=500


# ===========================================================================
# FRONTEND BUILD  (see frontend/.env.example)
# ===========================================================================

# Vite inlines this at BUILD time, so changing it requires a rebuild.
# Leave EMPTY for same-origin deployments (docker compose / nginx proxy):
# the client then uses the relative path /api and avoids CORS entirely.
# Set it only when the frontend is hosted separately from the API:
#   VITE_API_BASE_URL=https://api.your-domain.com/api
VITE_API_BASE_URL=
