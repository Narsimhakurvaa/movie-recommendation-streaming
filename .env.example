# ---------------------------------------------------------------------------
# CineVault - example environment configuration
# Copy to `.env` and adjust. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/cinevault
DATABASE_USERNAME=cinevault
DATABASE_PASSWORD=change-me-locally

# --- JWT ------------------------------------------------------------------
# Must be a Base64-encoded secret of at least 32 bytes (HS256).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_BASE64_SECRET_AT_LEAST_32_BYTES
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P30D
JWT_ISSUER=cinevault

# --- Redis (optional; app degrades gracefully to in-memory caching) --------
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=true

# --- External movie metadata provider -------------------------------------
# The application runs fully WITHOUT these using the bundled seed catalogue.
# Provider is selected by MOVIE_PROVIDER: `local` (default) or `tmdb`.
MOVIE_PROVIDER=local
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_TIMEOUT=PT5S

# --- Web ------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
SERVER_PORT=8080

# --- Seeding --------------------------------------------------------------
# Demo accounts are only created when this is true (never enable in prod).
SEED_DEMO_DATA=true
