# ---------------------------------------------------------------------------
# Frontend build-time configuration.
#
# Vite inlines VITE_* variables into the bundle at BUILD time. They are not
# read at runtime, so changing one requires a rebuild/redeploy. Never put a
# secret here: everything in this file ships to the browser.
# ---------------------------------------------------------------------------

# Absolute base URL of the backend API, including the /api suffix.
#
#   Same-origin deployment (Docker compose, nginx proxy): leave UNSET.
#     The client defaults to the relative path /api, which avoids CORS.
#
#   Standalone hosting (Vercel/Netlify with the API elsewhere): set it.
#     VITE_API_BASE_URL=https://api.your-domain.com/api
#
# When set to a cross-origin URL, that origin must also appear in the backend's
# CORS_ALLOWED_ORIGINS, or the browser will block every request.
VITE_API_BASE_URL=

# Dev server only: where `npm run dev` proxies /api. Ignored in production.
VITE_API_PROXY_TARGET=http://localhost:8080
